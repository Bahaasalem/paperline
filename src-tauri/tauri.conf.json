{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paperline",
  "version": "0.2.0",
  "identifier": "app.paperline.office",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Paperline",
        "width": 1360,
        "height": 860,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Documents, spreadsheets, presentations and PDF in one app",
    "longDescription": "Paperline opens, edits and creates Word, Excel, PowerPoint and PDF files, with an English and Arabic interface.",
    "copyright": "© 2026 Paperline",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      { "ext": ["pline"], "name": "Paperline file", "description": "Paperline file", "role": "Editor", "mimeType": "application/x-paperline" },
      { "ext": ["docx"], "name": "Word document", "role": "Editor", "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document" },
      { "ext": ["xlsx"], "name": "Excel workbook", "role": "Editor", "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" },
      { "ext": ["pptx"], "name": "PowerPoint presentation", "role": "Editor", "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation" },
      { "ext": ["pdf"], "name": "PDF document", "role": "Editor", "mimeType": "application/pdf" },
      { "ext": ["csv"], "name": "CSV file", "role": "Editor", "mimeType": "text/csv" }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["English", "Arabic"], "displayLanguageSelector": true },
      "wix": { "language": ["en-US"] }
    }
  }
}
